# Production Environment Variables for Shadhee Backend
# Copy this to your deployment platform's environment variables

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL (replace with your deployed frontend URL)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Firebase Configuration (for production auth)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Encryption Key (generate a strong random key for production)
ENCRYPTION_KEY=your-very-secure-encryption-key-here

# Optional: Database URL if you add a database later
# DATABASE_URL=your-database-connection-string