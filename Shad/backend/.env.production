# Production Environment Variables for Shadhee Backend
# Set these in your deployment platform (Render / Railway)

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL (update after deployment)
FRONTEND_URL=https://your-app-name.onrender.com

# Supabase Configuration (Optional - works without for demo)
# Get from: https://supabase.com/dashboard → Project Settings → API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption Key
ENCRYPTION_KEY=change-this-to-a-strong-random-key