{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start"
  },
  "environments": [
    {
      "name": "production",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "FRONTEND_URL",
          "value": "https://your-frontend-domain.vercel.app"
        },
        {
          "key": "ENCRYPTION_KEY",
          "value": "your-secure-encryption-key"
        }
      ]
    }
  ]
}